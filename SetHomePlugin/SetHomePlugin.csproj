<Project Sdk="Microsoft.NET.Sdk">

  <!-- A set-home Imlight plugin. Build it, then copy SetHomePlugin.dll into the server's plugins/ directory. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Point this to your copy of Imlight -->
    <ProjectReference Include="..\..\..\Imlight\src\Imlight.PluginApi\Imlight.PluginApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
